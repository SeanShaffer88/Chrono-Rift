extends "res://tests/test_harness_template.gd"
const Bake = preload("res://scripts/utilities/art_mesh.gd")
const Assets = preload("res://scripts/utilities/environment_assets.gd")
const Paper = preload("res://scenes/environment/papercraft.gd")
const Landmarks = preload("res://scenes/environment/dungeon_landmarks.gd")
const Grid = preload("res://scenes/georama/town_grid.gd")
const Visuals = preload("res://scenes/georama/town_visuals.gd")
const Floor = preload("res://scenes/dungeon/floor_generator.gd")

func run_assertions() -> void:
	var holder := Node3D.new()
	root.add_child(holder)
	var bake := Bake.new()
	bake.frame = Transform3D(Basis.IDENTITY, Vector3(4,0,0))
	bake.box(Vector3.ONE,Vector3.ZERO,Color.RED)
	bake.pipe(Vector3(0,1,0),Vector3(1,1,0),0.1,Color.BLUE)
	var merged := bake.finish(holder,"BudgetFixture")
	check(merged.mesh.get_surface_count() == 1 and merged.get_aabb().position.x > 3, "Static bake preserves frame transforms in one draw surface")
	var valid := true
	for normal: Vector3 in merged.mesh.surface_get_arrays(0)[Mesh.ARRAY_NORMAL]: valid = valid and normal.is_finite() and normal.length() > 0.9
	check(valid, "Baked primitives have finite unit normals")
	var normals: PackedVector3Array = merged.mesh.surface_get_arrays(0)[Mesh.ARRAY_NORMAL]
	var flat := true
	for index in range(0,normals.size(),3): flat = flat and normals[index].is_equal_approx(normals[index+1]) and normals[index].is_equal_approx(normals[index+2])
	check(flat, "Baked hard surfaces retain flat face normals without diagonal smoothing artifacts")
	var round_tree := Paper.round_tree(holder,Vector3.ZERO)
	check(round_tree.get_child_count() == 1 and round_tree.get_child(0).mesh.get_faces().size() < 1000, "Rounded paper canopy remains one bounded draw surface")
	check(Assets.bounds(round_tree).size.z > 1 and round_tree.find_children("*","CollisionObject3D",true,false).is_empty(), "Rounded canopy supports camera orbit without adding blockers")
	var grid := Grid.new()
	var bare := Visuals.make(grid.catalog.mayor_house,{"components":{}},true)
	check(not bare.has_node("Roof") and not bare.has_node("FoldedGables"), "Decorative polish does not grant an unrecovered roof")
	bare.free()
	var house := Visuals.make(grid.catalog.mayor_house,{"components":{"Roof":"roof","Door":"door","Bed":"bed","Stove":"stove","Resident":"resident"}})
	holder.add_child(house)
	check(house.has_node("Roof/FoldedGables") and house.has_node("Roof/FoldedAwning") and house.has_node("Door/Leaf/DoorJoinery"), "Gables, awning and joinery belong to their assembled parts")
	check(house.get_node("Roof/FoldedGables").mesh.get_surface_count() == 1 and house.get_node("PaperHouseDetails").mesh.get_surface_count() == 1, "House embellishments are batched by visibility group")
	check(house.get_node("Door/Collision").shape.size.x == 1.5, "Polished doorway retains the tested entrance width")
	house.get_node("Roof").hide()
	check(not house.get_node("Roof/FoldedGables").is_visible_in_tree() and not house.get_node("Roof/FoldedAwning").is_visible_in_tree(), "Interior roof hiding also removes new overhead decorations")
	var floor := Floor.new()
	holder.add_child(floor)
	check(floor.generate(1337), "Polished dungeon generation remains usable")
	var landmark: Node3D = floor.content.get_node("DungeonLandmarks")
	check(landmark.get_meta("landmark_count") <= 8 and landmark.get_meta("landmark_count") > 0, "Room landmarks have a hard mobile count budget")
	check(landmark.mesh.get_surface_count() == 1 and landmark.find_children("*","CollisionObject3D",true,false).is_empty(), "Wall landmarks add one draw surface and no gameplay collision")
	var face_count: int = landmark.mesh.get_faces().size()
	var again := Landmarks.build(holder,floor.layout.rooms,floor.layout.walkable,1337)
	check(again.mesh.get_faces().size() == face_count, "Landmark geometry is deterministic")
	var gate: Node = floor.content.get_node("ExitGate")
	check(gate.gate_material.get_shader_parameter("opacity") == 0.18, "Locked exit has subdued veil")
	floor.restore_progress({"key":true,"guard_defeated":true,"guard_hp":0,"healing":[]})
	check(gate.gate_material.get_shader_parameter("opacity") == 0.5, "Restored unlocked floor updates gate visuals without replaying collection")
	check(floor.content.get_node("EnvironmentArt/MasonryCourses").mesh.get_surface_count() == 1, "All masonry faces share a draw surface")
	holder.free()
